# ========================================
# CONFIGURATION SYSTÈME DE VEILLE IA
# ========================================
# Copier ce fichier en .env et remplir les valeurs

# ========================================
# POSTGRESQL
# ========================================
# Générer avec: openssl rand -base64 32
POSTGRES_USER=n8n
POSTGRES_PASSWORD=CHANGEME_GENERATE_SECURE_PASSWORD
POSTGRES_DB=veille_ia
# Port externe (5433 par défaut pour éviter conflit avec PostgreSQL local sur 5432)
POSTGRES_PORT=5433

# ========================================
# N8N
# ========================================
# Générer avec: openssl rand -hex 32
N8N_ENCRYPTION_KEY=CHANGEME_GENERATE_ENCRYPTION_KEY

# Note: n8n utilise maintenant un système de comptes utilisateurs
# Vous créerez votre email/mot de passe lors du premier accès (page /setup)
# Les anciennes variables Basic Auth ne sont plus utilisées

# URL publique (modifier si domaine custom)
N8N_HOST=localhost
N8N_PORT=5678
WEBHOOK_URL=http://localhost:5678/

# ========================================
# DISCORD
# ========================================
# Récupérer depuis: Discord → Paramètres Salon → Intégrations → Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
DISCORD_WEBHOOK_TECH_NEWS=https://discord.com/api/webhooks/YOUR_TECH_NEWS_WEBHOOK
DISCORD_WEBHOOK_COMPANIES=https://discord.com/api/webhooks/YOUR_COMPANIES_WEBHOOK
DISCORD_WEBHOOK_REDDIT=https://discord.com/api/webhooks/YOUR_REDDIT_WEBHOOK
DISCORD_WEBHOOK_OTHERS=https://discord.com/api/webhooks/YOUR_OTHERS_WEBHOOK
# Bot token from Discord Developer Portal → Bot → Token
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN
# Optional: comma-separated Discord user IDs allowed to trigger the bot.
# Empty = anyone in the configured channels can trigger.
DISCORD_ALLOWED_AUTHORS=

# ========================================
# GEMINI API (v1.3.0 - AI Content Analysis)
# ========================================
# Récupérer depuis: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# Modèle à utiliser (gemini-pro gratuit, gemini-1.5-pro pour plus de performance)
GEMINI_MODEL=gemini-pro

# ========================================
# MONITORING (OPTIONNEL)
# ========================================
# Grafana admin password
# Générer avec: openssl rand -base64 16
GRAFANA_PASSWORD=CHANGEME_GENERATE_PASSWORD

# ========================================
# RSSHUB (OPTIONNEL)
# ========================================
RSSHUB_CACHE_EXPIRE=300
RSSHUB_CACHE_TYPE=memory

# ========================================
# TIMEZONE
# ========================================
TZ=Europe/Paris
