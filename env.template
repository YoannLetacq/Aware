# ==========================================
# CONFIGURATION - Podcast Pipeline
# ==========================================
# Copy this file to .env and fill in values.
# NEVER commit .env — it is git-ignored.
# All CHANGEME_* and YOUR_* values are placeholders;
# replace each one before starting the stack.

# ==========================================
# POSTGRESQL
# ==========================================
# Generate with: openssl rand -base64 32
POSTGRES_USER=CHANGEME_POSTGRES_USER
POSTGRES_PASSWORD=CHANGEME_GENERATE_SECURE_PASSWORD
POSTGRES_DB=CHANGEME_POSTGRES_DB
# Host-side port (default 5433 avoids collision with a local Postgres on 5432)
POSTGRES_PORT=5433

# ==========================================
# N8N
# ==========================================
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=CHANGEME_GENERATE_ENCRYPTION_KEY
# Generate with: openssl rand -hex 24
N8N_API_KEY=CHANGEME_N8N_API_KEY
# Host-side port
N8N_PORT=5678
# Public webhook base URL (used by n8n for self-referencing webhooks)
WEBHOOK_URL=http://localhost:5678/

# ==========================================
# REDIS
# ==========================================
# Host-side port (internal-only binding)
REDIS_PORT=6379
# Generate with: openssl rand -base64 32
REDIS_PASSWORD=CHANGEME_GENERATE_REDIS_PASSWORD

# ==========================================
# DISCORD BOT
# ==========================================
# Bot token — Discord Developer Portal → Bot → Token
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN
# Application ID — Discord Developer Portal → General Information
DISCORD_APP_ID=YOUR_DISCORD_APP_ID
# Public key — Discord Developer Portal → General Information
DISCORD_PUBLIC_KEY=YOUR_DISCORD_PUBLIC_KEY
# Guild (server) ID for slash-command registration
DISCORD_GUILD_ID=YOUR_DISCORD_GUILD_ID
# Optional: comma-separated Discord user IDs allowed to trigger /podcast
# Leave empty to allow anyone in the configured channels
DISCORD_ALLOWED_AUTHORS=
# Operator Discord webhook URL for alerts (CAPTCHA, session expiry, etc.)
OPERATOR_DISCORD_WEBHOOK=YOUR_OPERATOR_DISCORD_WEBHOOK_URL

# ==========================================
# GEMINI API
# ==========================================
# Retrieve from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# Model to use (e.g. gemini-2.5-pro)
GEMINI_MODEL=YOUR_GEMINI_MODEL

# ==========================================
# GOOGLE BURNER ACCOUNT (NotebookLM session)
# ==========================================
# Use a dedicated Workspace burner account — NEVER your personal Google account.
# See QUICKSTART.md § "Google burner session seeding" for the setup procedure.
GOOGLE_BURNER_EMAIL=YOUR_GOOGLE_BURNER_EMAIL
GOOGLE_BURNER_PASSWORD=YOUR_GOOGLE_BURNER_PASSWORD
# TOTP seed for programmatic 2FA (optional — leave empty if using app-password)
GOOGLE_BURNER_TOTP_SEED=YOUR_GOOGLE_BURNER_TOTP_SEED

# ==========================================
# PLAYWRIGHT / NOTEBOOKLM WORKER
# ==========================================
# Path to storageState.json INSIDE the worker container
# (mounted from ./data/session — chmod 600, owned by worker UID)
NOTEBOOKLM_STORAGE_STATE_PATH=/app/session/storageState.json

# ==========================================
# INTERNAL SECURITY
# ==========================================
# Shared bearer token for worker ↔ n8n internal endpoints
# Generate with: openssl rand -hex 32
WORKER_SHARED_TOKEN=CHANGEME_GENERATE_WORKER_TOKEN
# n8n webhook URL for the bot to POST trigger payloads to
N8N_WEBHOOK_URL=http://n8n:5678/webhook/podcast

# ==========================================
# RATE LIMITS & KILL SWITCH
# ==========================================
# Maximum /podcast requests per user per day
RATE_LIMIT_PER_USER_DAY=3
# Maximum /podcast requests across all users per day
RATE_LIMIT_GLOBAL_DAY=20
# Set to 1 to block all new /podcast invocations (maintenance mode)
KILL_SWITCH=0

# ==========================================
# BACKUPS
# ==========================================
# Passphrase for encrypted backups (generate with: openssl rand -base64 32)
BACKUP_PASSPHRASE=CHANGEME_GENERATE_BACKUP_PASSPHRASE

# ==========================================
# TIMEZONE
# ==========================================
TZ=Europe/Paris
